# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
# Read `man 5 sway` for a complete reference.

### Autostart & Inicialização do Sistema ###
# Sincroniza as variáveis de ambiente com o DBus (Essencial para o PipeWire achar as pastas)
exec dbus-update-activation-environment --all

# Inicialização correta da pilha de áudio
exec sleep 10 && pipewire & sleep 2 && wireplumber & sleep 1 && pipewire-pulse

# Iniciar Waybar de forma independente
exec sleep 11 && waybar -c ~/.config/waybar/config -s ~/.config/waybar/style.css

# Utilitários
exec wl-clip-persist --clipboard regular
exec copyq --start-server

exec swaymsg "set $PATH $PATH:$HOME/.local/bin"

## font
font JetBrainsMono Nerd Font Mono 10
### Variables ###
# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulator
set $term foot

# Your preferred application launcher
set $menu rofi -show drun -theme ~/.config/rofi/config.rasi

# Menu Lateral de Utilidades
# bindsym $mod+Tab exec pkill wofi || wofi --show drun --location left_center --width 250 --height 100% --xoffset 10 --style ~/.config/wofi/sidebar.css

# Paleta Catppuccin Mocha
set $base      #1e1e2e
set $peach     #fab387
set $mauve     #cba6f7
set $text      #cdd6f4
set $surface   #313244

# Cores das Janelas: class         border  backgr. text    indicator child_border
client.focused          $peach  $peach  $base   $mauve   $peach
client.focused_inactive $surface $surface $text  $base    $surface
client.unfocused        $base   $base   #585b70 $base    $base

# No SwayFX, ajuste a sombra para algo mais suave
shadow_color #00000077 

### Output configuration ###
# Default wallpaper
output * bg  /home/gekko/Downloads/wallpapers/wallpaper2.png fill

### Idle configuration ###
### Configuração de Idle (Versão Faculdade) ###
# Adicione o 'swaylock' ou o script de forma síncrona
exec swayidle -w \
    timeout 300 '~/.local/bin/lock.sh' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '~/.local/bin/lock.sh fast'

# Atalho para você bloquear manualmente antes de sair da mesa na aula (Super + Esc)
bindsym $mod+Escape exec ~/.local/bin/lock.sh

### Input configuration ###
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}
 
input type:keyboard {
    xkb_layout "br"
}

### Key bindings ###
# Basics:
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
	bindsym $mod+d exec rofi -show combi -combi-modi "drun,run" -theme ~/.config/rofi/config.rasi

    # Drag floating windows by holding down $mod and left mouse button.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Saída imediata sem confirmação
    bindsym $mod+Shift+e exit

    # Abrir Gerenciador de Arquivos (Mod+e)
    bindsym $mod+e exec thunar
    
    # Barra lateral
    bindsym $mod+Tab exec pkill wofi || ~/.local/bin/dashboard.sh

    # Bloquear ao fechar a tampa (Lid Switch)
	bindswitch lid:on exec ~/.local/bin/lock.sh
# Moving around:
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

# Workspaces:
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

# Layout stuff:
    bindsym $mod+b splith
    bindsym $mod+v splitv
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+f fullscreen
    bindsym $mod+Shift+space floating toggle
    bindsym $mod+space focus mode_toggle
    bindsym $mod+a focus parent

# Scratchpad:
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show

# Resizing containers:
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Utilities:
    # Controle de Volume
    bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
    bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
    bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

    # Controle de Brilho
    bindsym XF86MonBrightnessUp exec brightnessctl set +10%
    bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

    # Screenshots
    bindsym Print exec grim - | tee /home/gekko/Imagens/$(date +%Y-%m-%d_%H-%M-%S).png | wl-copy
    bindsym $mod+Shift+s exec /home/gekko/screenshot.sh

######################################
### VISUAIS EXCLUSIVOS DO SWAYFX   ###
######################################

# Bordas arredondadas (SwayFX 0.5+)
corner_radius 10

# Ativar animações globais
animations enable

# Configurar animações de workspace
# Nota: O SwayFX usa transições de 'fade' ou 'zoom' para workspaces
animation workspace_switch_duration 300
animation workspace_switch_curve easeOutExpo

# Sombras (O nome correto é shadow_blur_radius)
shadows enable
shadow_blur_radius 20

# Efeitos de Blur (Vidro embaçado)
blur enable
blur_xray enable
blur_passes 3
blur_radius 7

# Escurece janelas inativas (Foco)
default_dim_inactive 0.15

# 1. Forçar transparência em tudo para o Blur brilhar
for_window [app_id=".*"] opacity 0.85
# Exceções (1.0 = totalmente opaco)
for_window [app_id="app.zen_browser.zen"] opacity 1.0
for_window [app_id="obsidian"] opacity 1.0
for_window [class=".*"] opacity 0.85 # (Apenas se usar XWayland)

# Força janelas do Ghidra a abrirem flutuando para evitar o loop de redimensionamento
for_window [class="ghidra-Ghidra"] floating enable
for_window [title="Ghidra"] floating enable

# 2. Melhorar o espaçamento (Gaps)
gaps inner 12
gaps outer 5
smart_gaps off

# 3. Ajustar a borda (importante para o arredondamento)
default_border pixel 2

# 4. Efeitos no Menu (Wofi) e na Barra (Waybar)
layer_effects "waybar" blur enable
layer_effects "wofi" blur enable; corner_radius 12

include /etc/sway/config.d/*
